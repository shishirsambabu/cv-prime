# CV Prime — environment variables. Copy to .env.local for development and set
# the production values in Vercel → Settings → Environment Variables.
# NEVER commit real values. .env.local is gitignored.

# --- App ---
NEXT_PUBLIC_APP_URL=https://cv-prime.in

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # required for entitlements, webhooks, and all email

# --- Encryption (OpenRouter key storage) ---
ENCRYPTION_SECRET=

# --- Cashfree (payments) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=production             # or sandbox
CASHFREE_MONTHLY_PLAN_ID=

# --- Email: Resend (lifecycle + transactional) ---
RESEND_API_KEY=                     # from resend.com — enables all sending
EMAIL_FROM="CV Prime <support@cv-prime.in>"   # From needs a verified domain, not a real mailbox
EMAIL_REPLY_TO=support@cv-prime.in            # replies must reach a real inbox
RESEND_WEBHOOK_SECRET=              # whsec_... from the Resend webhook you create → /api/webhooks/resend

# --- Scheduled jobs (Vercel Cron) ---
CRON_SECRET=                        # long random string; Vercel Cron sends it as a Bearer token

# --- Admin tooling ---
ADMIN_EMAILS=you@example.com        # comma-separated allowlist for /api/admin/entitlement-audit
ALLOW_EMAIL_PREVIEW=                # set to "true" to allow /api/dev/email-preview in production

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
